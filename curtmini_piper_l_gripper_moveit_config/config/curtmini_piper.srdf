<?xml version="1.0" encoding="UTF-8"?>
<robot name="curtmini_piper">
  <group name="arm">
    <chain base_link="piper_base_link" tip_link="piper_tcp_link" />
  </group>
  <group name="gripper">
    <joint name="piper_gripper" />
    <link name="piper_gripper_link1" />
    <link name="piper_gripper_link2" />
  </group>
  <passive_joint name="piper_gripper_joint1" />
  <passive_joint name="piper_gripper_joint2" />
  <end_effector name="gripper_eef" parent_link="piper_gripper_tcp" group="gripper" parent_group="arm" />

  <group_state name="home" group="arm">
    <joint name="piper_joint1" value="0.0" />
    <joint name="piper_joint2" value="1.0" />
    <joint name="piper_joint3" value="-1.2" />
    <joint name="piper_joint4" value="0.0" />
    <joint name="piper_joint5" value="0.0" />
    <joint name="piper_joint6" value="0.0" />
  </group_state>
  <group_state name="UP" group="arm">
    <joint name="piper_joint1" value="0.0" />
    <joint name="piper_joint2" value="1.0" />
    <joint name="piper_joint3" value="-1.2" />
    <joint name="piper_joint4" value="0.0" />
    <joint name="piper_joint5" value="-1.2835299" />
    <joint name="piper_joint6" value="0.0" />
  </group_state>
  <!-- Parking pose before shutdown; matches the startup homing pose in curtmini_piper_bringup/config/homing.yaml. -->
  <group_state name="REST" group="arm">
    <joint name="piper_joint1" value="0.0" />
    <joint name="piper_joint2" value="0.0872665" />
    <joint name="piper_joint3" value="-0.0872665" />
    <joint name="piper_joint4" value="0.0" />
    <joint name="piper_joint5" value="0.0" />
    <joint name="piper_joint6" value="0.0" />
  </group_state>
  <group_state name="open" group="gripper"><joint name="piper_gripper" value="0.1" /></group_state>
  <group_state name="closed" group="gripper"><joint name="piper_gripper" value="0.0" /></group_state>

  <disable_collisions link1="chassis" link2="front_left_wheel" reason="Adjacent" />
  <disable_collisions link1="chassis" link2="front_right_wheel" reason="Adjacent" />
  <disable_collisions link1="chassis" link2="back_left_wheel" reason="Adjacent" />
  <disable_collisions link1="chassis" link2="back_right_wheel" reason="Adjacent" />
  <disable_collisions link1="piper_gripper_base" link2="tool_camera_body_link" reason="Adjacent" />
  <disable_collisions link1="chassis" link2="piper_base_link" reason="Adjacent" />
  <disable_collisions link1="piper_base_link" link2="piper_link1" reason="Adjacent" />
  <disable_collisions link1="piper_link1" link2="piper_link2" reason="Adjacent" />
  <disable_collisions link1="piper_link2" link2="piper_link3" reason="Adjacent" />
  <disable_collisions link1="piper_link3" link2="piper_link4" reason="Adjacent" />
  <disable_collisions link1="piper_link4" link2="piper_link5" reason="Adjacent" />
  <disable_collisions link1="piper_link5" link2="piper_link6" reason="Adjacent" />
  <disable_collisions link1="piper_link6" link2="piper_flange_link" reason="Adjacent" />
  <disable_collisions link1="piper_flange_link" link2="piper_gripper_base" reason="Adjacent" />
  <disable_collisions link1="piper_gripper_base" link2="piper_gripper_link" reason="Adjacent" />
  <disable_collisions link1="piper_gripper_base" link2="piper_gripper_link1" reason="Adjacent" />
  <disable_collisions link1="piper_gripper_base" link2="piper_gripper_link2" reason="Adjacent" />
  <disable_collisions link1="piper_gripper_link1" link2="piper_gripper_link2" reason="Adjacent" />
</robot>
