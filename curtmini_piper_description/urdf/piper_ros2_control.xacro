<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="piper_ros2_control" params="prefix">
    <ros2_control name="${prefix}FakeSystem" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>

      <xacro:macro name="piper_control_joint" params="joint_name">
        <joint name="${prefix}${joint_name}">
          <command_interface name="position" />
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity" />
        </joint>
      </xacro:macro>

      <xacro:piper_control_joint joint_name="joint1" />
      <xacro:piper_control_joint joint_name="joint2" />
      <xacro:piper_control_joint joint_name="joint3" />
      <xacro:piper_control_joint joint_name="joint4" />
      <xacro:piper_control_joint joint_name="joint5" />
      <xacro:piper_control_joint joint_name="joint6" />
    </ros2_control>
  </xacro:macro>
</robot>
